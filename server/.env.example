# --- Sky-AI (OpenAI-kompatibel /chat/completions) — velg ÉN av disse måtene ---

# A) Legacy: bare Groq (enklest hvis du allerede bruker det)
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant

# B) Anbefalt: eksplisitt leverandør (Google Gemini, OpenRouter, Together, lokal Ollama, m.m.)
# LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-8b-instant

# Eksempel — Google Gemini (OpenAI-kompatibel API, ofte gratis kvote — sjekk siste pris/kvote i Google AI Studio):
# LLM_API_KEY=din_gemini_api_nøkkel
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.0-flash

# Eksempel — lokal Ollama (helt gratis etter at modellen er lastet ned):
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.2

# RAG (bedrift): OpenAI embeddings (text-embedding-3-small). Uten nøkkel kjører LLM uten arkiv-kontekst.
# OPENAI_API_KEY=
# Valgfritt alias: EMBEDDINGS_API_KEY=
# RAG_TOP_K=4
# RAG_SYNC_COOLDOWN_MS=600000
