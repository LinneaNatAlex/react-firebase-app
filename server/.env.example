PORT=3001

# Firebase Admin (velg én måte):
# A) Last ned JSON fra Firebase Console → Project settings → Service accounts → Generate new private key
#    Legg filen i server-mappen som firebase-admin-key.json (ikke commit!) og bruk:
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-admin-key.json
#
# B) Eller hele JSON som én linje:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Bedrifts-AI: kun lokal Python (ingen Groq/LLM på Node)
# Start: cd ai-service && uvicorn main:app --host 127.0.0.1 --port 8000
# PYTHON_AI_URL=http://127.0.0.1:8000
# PYTHON_AI_SECRET=valgfritt_samme_som_INTERNAL_SECRET_i_Python

# Valgfritt, av som standard: OpenAI-embeddings for RAG (koster penger). Ikke en del av standardoppsettet.
# ENABLE_OPENAI_RAG=1
# OPENAI_API_KEY=
