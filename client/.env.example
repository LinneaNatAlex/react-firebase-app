# Firebase (gratis Spark-tier – se firebase.google.com/pricing)
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Node-backend (videresender til lokal Python-AI). Se server/.env.example:
VITE_AI_API_URL=http://localhost:3001
# Valgfritt: ekstern Stripe Checkout e.l. (i tillegg til intern side /priser)
# VITE_AI_UPGRADE_URL=https://buy.stripe.com/...
# Valgfritt: offentlig kontakt-e-post (Om oss, priser, personvern/vilkår-maler)
# VITE_CONTACT_EMAIL=din@bedrift.no
