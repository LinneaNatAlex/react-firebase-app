rules_version = '2';
// Deploy: firebase deploy --only storage
// (Storage må være aktivert i Firebase Console.)
service firebase.storage {
  match /b/{bucket}/o {
    // Offentlige PDF-er på CV (leses uten innlogging via nedlastingslenke)
    match /profiles/{userId}/public_pdfs/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf'
            || request.resource.contentType == 'application/octet-stream');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // CV/søknad-PDF ved jobbsøknad (lagres under applications/…)
    match /applications/{userId}/{jobId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf'
            || request.resource.contentType == 'application/octet-stream');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
