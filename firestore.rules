// Firestore-regler for denne appen. Deploy:
//   firebase deploy --only firestore:rules
// (krever firebase login og .firebaserc med prosjekt-id)

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function newspaperRole() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.newspaperRole
        : null;
    }

    function isNewspaperStaff() {
      return request.auth != null && newspaperRole() in ['journalist', 'editor'];
    }

    function isNewspaperEditor() {
      return request.auth != null && newspaperRole() == 'editor';
    }

    match /magazineArticles/{articleId} {
      allow read: if resource.data.status == 'published' ||
        (request.auth != null && (
          resource.data.authorId == request.auth.uid ||
          isNewspaperEditor()
        ));

      allow create: if request.auth != null &&
        request.resource.data.authorId == request.auth.uid &&
        isNewspaperStaff() &&
        request.resource.data.status == 'draft';

      allow update: if request.auth != null && (
        isNewspaperEditor() ||
        (
          resource.data.authorId == request.auth.uid &&
          isNewspaperStaff() &&
          resource.data.status == 'draft' &&
          request.resource.data.status == 'draft'
        )
      ) || (
        resource.data.status == 'published' &&
        request.resource.data.viewCount == resource.data.get('viewCount', 0) + 1 &&
        request.resource.data.title == resource.data.title &&
        request.resource.data.slug == resource.data.slug &&
        request.resource.data.bodyHtml == resource.data.bodyHtml &&
        request.resource.data.excerpt == resource.data.excerpt &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.authorId == resource.data.authorId &&
        request.resource.data.publishedAt == resource.data.publishedAt &&
        request.resource.data.get('coverImageUrl', '') == resource.data.get('coverImageUrl', '') &&
        request.resource.data.get('authorName', '') == resource.data.get('authorName', '')
      );

      allow delete: if request.auth != null && (
        isNewspaperEditor() ||
        (
          resource.data.authorId == request.auth.uid &&
          isNewspaperStaff() &&
          resource.data.status == 'draft'
        )
      );
    }

    match /companyProfiles/{companyId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.uid == companyId;
    }

    match /profiles/{userId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    match /jobs/{jobId} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.resource.data.companyId == request.auth.uid;
      allow update, delete: if request.auth != null &&
        resource.data.companyId == request.auth.uid;
    }

    match /applications/{appId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        resource.data.companyId == request.auth.uid
      );
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null &&
        resource.data.companyId == request.auth.uid;
      allow delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;
    }

    match /companyJobLibrary/{itemId} {
      allow read: if request.auth != null && resource.data.companyId == request.auth.uid;
      allow create: if request.auth != null &&
        request.resource.data.companyId == request.auth.uid &&
        request.resource.data.companyId is string &&
        request.resource.data.title is string &&
        request.resource.data.description is string;
      allow update: if request.auth != null && resource.data.companyId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.companyId == request.auth.uid;
    }

    match /jobseekerCoverLetters/{itemId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.userId is string &&
        request.resource.data.coverLetter is string;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /companyFollowers/{companyId}/users/{followerUid} {
      allow read: if true;
      allow create, delete: if request.auth != null && request.auth.uid == followerUid;
    }

    match /companyToCompanyFollows/{companyId}/following/{targetId} {
      allow read: if true;
      allow create, delete: if request.auth != null && request.auth.uid == companyId;
    }

    match /users/{userId}/followedCompanies/{companyId} {
      allow read: if true;
      allow create, delete: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/friends/{friendUid} {
      allow read: if true;
      allow create, delete: if request.auth != null &&
        (request.auth.uid == userId || request.auth.uid == friendUid);
    }

    match /friendRequests/{pairKey} {
      allow read: if request.auth != null &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.fromUid == request.auth.uid;
      allow delete: if request.auth != null &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow update: if false;
    }

    // Brukerdokument: offentlig lesbar (profilsider, søk). AuthContext + LoginPage krever dette.
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      // Egen konto (kontosletting); ikke admin – AdminDashboard trenger egne regler/Cloud Functions for full tilgang
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/notifications/{notificationId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null &&
        request.resource.data.actorId == request.auth.uid;
      allow delete: if false;
    }
  }
}
