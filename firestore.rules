// Firestore-regler for denne appen. Deploy:
//   firebase deploy --only firestore:rules
// (krever firebase login og .firebaserc med prosjekt-id)

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Samme e-post som client/src/config/adminEmail.js (Google-innlogging)
    function isPlatformAdmin() {
      return request.auth != null &&
        request.auth.token.email == 'linneahetty94@gmail.com';
    }

    function newspaperRole() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.newspaperRole
        : null;
    }

    function isNewspaperStaff() {
      return request.auth != null && newspaperRole() in ['journalist', 'editor'];
    }

    function isNewspaperEditor() {
      return request.auth != null && newspaperRole() == 'editor';
    }

    function areFriendsPair(a, b) {
      return exists(/databases/$(database)/documents/users/$(a)/friends/$(b));
    }

    function chatConvIdFromParts(p) {
      return p[0] + '_' + p[1];
    }

    function participantsSortedTwo(p) {
      return p is list && p.size() == 2 && p[0] is string && p[1] is string && p[0] < p[1];
    }

    function userTypeOf(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        ? get(/databases/$(database)/documents/users/$(uid)).data.get('userType', '')
        : '';
    }

    function canChatParticipants(a, b) {
      let ta = userTypeOf(a);
      let tb = userTypeOf(b);
      return (ta == 'jobseeker' && tb == 'jobseeker' && areFriendsPair(a, b)) ||
        (ta == 'company' && tb == 'jobseeker') ||
        (ta == 'jobseeker' && tb == 'company');
    }

    function notBlockedPair(a, b) {
      return !exists(/databases/$(database)/documents/users/$(a)/blockedUsers/$(b)) &&
        !exists(/databases/$(database)/documents/users/$(b)/blockedUsers/$(a));
    }

    function conversationParticipants(convId) {
      return get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
    }

    // Eier ser hvem de har blokkert; «blockedUid» kan lese doc der de er blokkert (for isEitherBlocked / chat).
    match /users/{userId}/blockedUsers/{blockedUid} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.uid == blockedUid
      );
      allow create: if request.auth != null && request.auth.uid == userId && blockedUid != userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Innboks per bruker (speiler conversations/{convId}) – liste uten array-contains på hele collection.
    match /users/{userId}/conversationRefs/{convId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null &&
        conversationParticipants(convId) is list &&
        request.auth.uid in conversationParticipants(convId) &&
        userId in conversationParticipants(convId) &&
        request.resource.data.participants == conversationParticipants(convId);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Les samtale-metadata for deltakere (også ved blokkering).
    // Read krever ikke sortert participants[] — hvis regelen krevde participantsSortedTwo,
    // kunne én gammel rad (feil rekkefølge) få hele array-contains-listespørringen til å feile.
    // Opprett/oppdater validerer fortsatt sortert par + canChatParticipants.
    // Meldinger under /messages har fortsatt notBlockedPair.
    match /conversations/{convId} {
      // Les: standard mønster for array-contains-spørring (må speile query-filteret).
      allow read: if request.auth != null &&
        resource.data.participants is list &&
        request.auth.uid in resource.data.participants;

      allow create: if request.auth != null &&
        participantsSortedTwo(request.resource.data.participants) &&
        convId == chatConvIdFromParts(request.resource.data.participants) &&
        request.auth.uid in request.resource.data.participants &&
        canChatParticipants(request.resource.data.participants[0], request.resource.data.participants[1]) &&
        notBlockedPair(request.resource.data.participants[0], request.resource.data.participants[1]);

      allow update: if request.auth != null &&
        request.auth.uid in resource.data.participants &&
        participantsSortedTwo(resource.data.participants) &&
        request.resource.data.participants == resource.data.participants &&
        canChatParticipants(resource.data.participants[0], resource.data.participants[1]) &&
        notBlockedPair(resource.data.participants[0], resource.data.participants[1]);

      match /messages/{msgId} {
        allow read: if request.auth != null &&
          request.auth.uid in conversationParticipants(convId) &&
          participantsSortedTwo(conversationParticipants(convId)) &&
          notBlockedPair(conversationParticipants(convId)[0], conversationParticipants(convId)[1]);

        allow create: if request.auth != null &&
          request.resource.data.senderId == request.auth.uid &&
          request.auth.uid in conversationParticipants(convId) &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 4000 &&
          participantsSortedTwo(conversationParticipants(convId)) &&
          notBlockedPair(conversationParticipants(convId)[0], conversationParticipants(convId)[1]) &&
          canChatParticipants(conversationParticipants(convId)[0], conversationParticipants(convId)[1]);
      }
    }

    match /users/{subjectUid}/writtenReferences/{authorUid} {
      allow read: if resource.data.status == 'published' ||
        (request.auth != null && (
          request.auth.uid == subjectUid || request.auth.uid == authorUid
        ));

      allow create: if request.auth != null &&
        request.auth.uid == subjectUid &&
        !exists(/databases/$(database)/documents/users/$(subjectUid)/writtenReferences/$(authorUid)) &&
        areFriendsPair(subjectUid, authorUid) &&
        request.resource.data.subjectUid == subjectUid &&
        request.resource.data.authorUid == authorUid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.body == '';

      allow update: if request.auth != null &&
        request.auth.uid == authorUid &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'published' &&
        request.resource.data.body is string &&
        request.resource.data.body.size() >= 20 &&
        request.resource.data.body.size() <= 4000 &&
        request.resource.data.subjectUid == resource.data.subjectUid &&
        request.resource.data.authorUid == resource.data.authorUid;

      allow delete: if request.auth != null && (
        request.auth.uid == subjectUid || request.auth.uid == authorUid
      );
    }

    match /magazineArticles/{articleId} {
      allow read: if resource.data.status == 'published' ||
        (request.auth != null && (
          resource.data.authorId == request.auth.uid ||
          isNewspaperEditor()
        ));

      allow create: if request.auth != null &&
        request.resource.data.authorId == request.auth.uid &&
        isNewspaperStaff() &&
        request.resource.data.status == 'draft';

      allow update: if request.auth != null && (
        isNewspaperEditor() ||
        (
          resource.data.authorId == request.auth.uid &&
          isNewspaperStaff() &&
          resource.data.status == 'draft' &&
          request.resource.data.status == 'draft'
        )
      ) || (
        resource.data.status == 'published' &&
        request.resource.data.viewCount == resource.data.get('viewCount', 0) + 1 &&
        request.resource.data.title == resource.data.title &&
        request.resource.data.slug == resource.data.slug &&
        request.resource.data.bodyHtml == resource.data.bodyHtml &&
        request.resource.data.excerpt == resource.data.excerpt &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.authorId == resource.data.authorId &&
        request.resource.data.publishedAt == resource.data.publishedAt &&
        request.resource.data.get('coverImageUrl', '') == resource.data.get('coverImageUrl', '') &&
        request.resource.data.get('authorName', '') == resource.data.get('authorName', '')
      );

      allow delete: if request.auth != null && (
        isNewspaperEditor() ||
        (
          resource.data.authorId == request.auth.uid &&
          isNewspaperStaff() &&
          resource.data.status == 'draft'
        )
      );
    }

    match /companyProfiles/{companyId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.uid == companyId;
    }

    match /profiles/{userId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;

      // Offentlige CV-PDF-er uten Firebase Storage (base64 per dokument, maks ~650 KB råfil)
      match /publicPdfs/{pdfId} {
        allow read: if true;
        allow create: if request.auth != null && request.auth.uid == userId
          && request.resource.data.keys().hasAll(['title', 'fileName', 'dataBase64', 'uploadedAt', 'sizeBytes'])
          && request.resource.data.dataBase64.size() < 900000
          && request.resource.data.sizeBytes is int
          && request.resource.data.sizeBytes <= 700000;
        allow update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /jobs/{jobId} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.resource.data.companyId == request.auth.uid;
      allow update, delete: if request.auth != null && (
        resource.data.companyId == request.auth.uid || isPlatformAdmin()
      );
    }

    match /applications/{appId} {
      // Egen linje for admin: ellers kan list-queries (getDocs uten where) feile når regelen blander resource.data med OR.
      allow read: if isPlatformAdmin();
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        resource.data.companyId == request.auth.uid
      );
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null &&
        resource.data.companyId == request.auth.uid;
      allow delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;
    }

    match /companyJobLibrary/{itemId} {
      allow read: if request.auth != null && resource.data.companyId == request.auth.uid;
      allow create: if request.auth != null &&
        request.resource.data.companyId == request.auth.uid &&
        request.resource.data.companyId is string &&
        request.resource.data.title is string &&
        request.resource.data.description is string;
      allow update: if request.auth != null && resource.data.companyId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.companyId == request.auth.uid;
    }

    match /jobseekerCoverLetters/{itemId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.userId is string &&
        request.resource.data.coverLetter is string;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /companyFollowers/{companyId}/users/{followerUid} {
      allow read: if true;
      allow create, delete: if request.auth != null && request.auth.uid == followerUid;
    }

    match /companyToCompanyFollows/{companyId}/following/{targetId} {
      allow read: if true;
      allow create, delete: if request.auth != null && request.auth.uid == companyId;
    }

    match /users/{userId}/followedCompanies/{companyId} {
      allow read: if true;
      allow create, delete: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/friends/{friendUid} {
      allow read: if true;
      allow create, delete: if request.auth != null &&
        (request.auth.uid == userId || request.auth.uid == friendUid);
    }

    match /friendRequests/{pairKey} {
      // get på manglende dokument: resource finnes ikke — må tillate eksplisitt (ellers permission-denied).
      allow get: if request.auth != null && (
        !exists(/databases/$(database)/documents/friendRequests/$(pairKey)) ||
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
      allow list: if request.auth != null && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
      allow create: if request.auth != null && request.resource.data.fromUid == request.auth.uid;
      allow delete: if request.auth != null &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow update: if false;
    }

    // Brukerdokument: offentlig lesbar (profilsider, søk). AuthContext + LoginPage krever dette.
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        request.auth.uid == userId || isPlatformAdmin()
      );
      allow delete: if request.auth != null && (
        request.auth.uid == userId || isPlatformAdmin()
      );
    }

    match /users/{userId}/notifications/{notificationId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null &&
        request.resource.data.actorId == request.auth.uid;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
